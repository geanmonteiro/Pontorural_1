rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared security primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function accessLinkPath() {
      return /databases/$(database)/documents/userAccessLinks/$(request.auth.uid);
    }

    function isActiveWorkspaceMember(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && exists(accessLinkPath())
        && get(accessLinkPath()).data.ownerId == userId
        && get(accessLinkPath()).data.active == true;
    }

    function memberHasCompany(userId, companyId) {
      return isActiveWorkspaceMember(userId)
        && companyId in get(accessLinkPath()).data.allowedCompanyIds;
    }

    function memberProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId)/accessProfiles/$(get(accessLinkPath()).data.profileId);
    }

    function memberHasPermission(userId, perm) {
      return isActiveWorkspaceMember(userId)
        && exists(memberProfilePath(userId))
        && perm in get(memberProfilePath(userId)).data.permissions;
    }

    // Entity validation helpers (matching firebase-blueprint.json limits)
    function isValidCompany(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'cnpj', 'address', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'cnpj', 'address', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.cnpj is string && data.cnpj.size() >= 11 && data.cnpj.size() <= 24
        && data.address is string && data.address.size() >= 4 && data.address.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'name', 'descriptionText', 'restDays',
          'defaultMorningEnd', 'defaultAfternoonStart', 'showPreFilledInterval',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'name', 'descriptionText', 'restDays',
          'defaultMorningEnd', 'defaultAfternoonStart', 'showPreFilledInterval',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && isValidId(data.companyId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.descriptionText is string && data.descriptionText.size() >= 2 && data.descriptionText.size() <= 240
        && data.restDays is list && data.restDays.size() <= 7
        && (data.restDays.size() == 0 || (data.restDays[0] is int && data.restDays[0] >= 0 && data.restDays[0] <= 6))
        && data.defaultMorningEnd is string && data.defaultMorningEnd.size() <= 10
        && data.defaultAfternoonStart is string && data.defaultAfternoonStart.size() <= 10
        && data.showPreFilledInterval is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmployee(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'companyId', 'scheduleId', 'name', 'role', 'cpf',
          'registrationNumber', 'admissionDate', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyId', 'scheduleId', 'name', 'role', 'cpf',
          'registrationNumber', 'admissionDate', 'active', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && isValidId(data.companyId)
        && isValidId(data.scheduleId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 120
        && data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20
        && data.registrationNumber is string && data.registrationNumber.size() >= 1 && data.registrationNumber.size() <= 32
        && data.admissionDate is string && data.admissionDate.size() == 10 && data.admissionDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomHoliday(data, userId) {
      return data.keys().hasAll(['ownerId', 'companyId', 'name', 'dateKey', 'recurringYearly', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'companyId', 'name', 'dateKey', 'recurringYearly', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && isValidId(data.companyId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.dateKey is string && data.dateKey.size() >= 5 && data.dateKey.size() <= 10
        && data.recurringYearly is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthOverride(data, userId) {
      return data.keys().hasAll(['ownerId', 'companyId', 'yearMonth', 'targetId', 'dayOverrides', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'companyId', 'yearMonth', 'targetId', 'dayOverrides', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && isValidId(data.companyId)
        && data.yearMonth is string && data.yearMonth.size() == 7 && data.yearMonth.matches('^\\d{4}-\\d{2}$')
        && isValidId(data.targetId)
        && data.dayOverrides is map && data.dayOverrides.size() <= 31
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscription(data, userId) {
      return data.keys().hasAll(['ownerId', 'planId', 'billingCycle', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'planId', 'billingCycle', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.planId in ['essencial', 'profissional', 'escritorio']
        && data.billingCycle in ['monthly', 'yearly']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMigration(data, userId) {
      return data.keys().hasAll(['ownerId', 'version', 'name', 'status', 'appliedAt'])
        && data.keys().hasOnly(['ownerId', 'version', 'name', 'status', 'appliedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.version is int && data.version >= 1 && data.version <= 10000
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.status == 'applied'
        && data.appliedAt is timestamp;
    }

    function isValidAccessProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'description', 'permissions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'description', 'permissions', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 200
        && data.permissions is list && data.permissions.size() <= 64
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeamUser(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'authUid', 'displayName', 'email',
          'profileId', 'allowedCompanyIds', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authUid', 'displayName', 'email',
          'profileId', 'allowedCompanyIds', 'active', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && isValidId(data.authUid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && isValidId(data.profileId)
        && data.allowedCompanyIds is list && data.allowedCompanyIds.size() <= 50
        && (data.allowedCompanyIds.size() == 0 || isValidId(data.allowedCompanyIds[0]))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessLink(data) {
      return data.keys().hasAll([
          'ownerId', 'authUid', 'teamUserId', 'profileId',
          'allowedCompanyIds', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'authUid', 'teamUserId', 'profileId',
          'allowedCompanyIds', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.authUid)
        && isValidId(data.teamUserId)
        && isValidId(data.profileId)
        && data.allowedCompanyIds is list && data.allowedCompanyIds.size() <= 50
        && (data.allowedCompanyIds.size() == 0 || isValidId(data.allowedCompanyIds[0]))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /userAccessLinks/{targetAuthUid} {
      allow get: if isSignedIn() && isValidId(targetAuthUid)
        && (request.auth.uid == targetAuthUid || (resource != null && existing().ownerId == request.auth.uid));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(targetAuthUid)
        && isValidAccessLink(incoming())
        && incoming().authUid == targetAuthUid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().ownerId == request.auth.uid || memberHasPermission(incoming().ownerId, 'users.create'));
      allow update: if isSignedIn() && isValidId(targetAuthUid)
        && isValidAccessLink(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().authUid == existing().authUid
        && incoming().teamUserId == existing().teamUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['profileId', 'allowedCompanyIds', 'active', 'updatedAt'])
        && (existing().ownerId == request.auth.uid || memberHasPermission(existing().ownerId, 'users.edit'));
      allow delete: if isSignedIn() && isValidId(targetAuthUid)
        && (existing().ownerId == request.auth.uid || memberHasPermission(existing().ownerId, 'users.delete'));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;

      match /migrations/{migrationId} {
        allow get: if isOwner(userId) && isValidId(migrationId) && (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(migrationId)
          && isValidMigration(incoming(), userId)
          && incoming().appliedAt == request.time;
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow get: if (isOwner(userId) || isActiveWorkspaceMember(userId))
          && isValidId(subscriptionId)
          && (resource == null || existing().ownerId == userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(subscriptionId)
          && isValidSubscription(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(subscriptionId)
          && isValidSubscription(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['planId', 'billingCycle', 'updatedAt']);
        allow delete: if false;
      }

      match /accessProfiles/{profileId} {
        allow get: if (isOwner(userId) || (isActiveWorkspaceMember(userId) && (get(accessLinkPath()).data.profileId == profileId || memberHasPermission(userId, 'profiles.view') || memberHasPermission(userId, 'users.view'))))
          && isValidId(profileId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || ((memberHasPermission(userId, 'profiles.view') || memberHasPermission(userId, 'users.view')) && resource.data.ownerId == userId);
        allow create: if (isOwner(userId) || memberHasPermission(userId, 'profiles.create'))
          && isValidId(profileId)
          && isValidAccessProfile(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if (isOwner(userId) || memberHasPermission(userId, 'profiles.edit'))
          && isValidId(profileId)
          && isValidAccessProfile(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'permissions', 'updatedAt']);
        allow delete: if (isOwner(userId) || memberHasPermission(userId, 'profiles.delete'))
          && isValidId(profileId)
          && existing().ownerId == userId;
      }

      match /companies/{companyId} {
        allow get: if (isOwner(userId) || memberHasCompany(userId, companyId))
          && isValidId(companyId)
          && (resource == null || existing().ownerId == userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(companyId)
          && isValidCompany(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if (isOwner(userId) || (memberHasCompany(userId, companyId) && memberHasPermission(userId, 'companies.edit')))
          && isValidId(companyId)
          && isValidCompany(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'cnpj', 'address', 'updatedAt']);
        allow delete: if (isOwner(userId) || (memberHasCompany(userId, companyId) && memberHasPermission(userId, 'companies.delete')))
          && isValidId(companyId)
          && existing().ownerId == userId;
      }

      match /schedules/{scheduleId} {
        allow get: if (isOwner(userId) || (resource != null && memberHasCompany(userId, existing().companyId)))
          && isValidId(scheduleId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (isActiveWorkspaceMember(userId) && resource.data.companyId in get(accessLinkPath()).data.allowedCompanyIds);
        allow create: if (isOwner(userId) || (memberHasCompany(userId, incoming().companyId) && memberHasPermission(userId, 'schedules.create')))
          && isValidId(scheduleId)
          && isValidSchedule(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/companies/$(incoming().companyId));
        allow update: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'schedules.edit')))
          && isValidId(scheduleId)
          && isValidSchedule(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().companyId == existing().companyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'descriptionText', 'restDays', 'defaultMorningEnd',
            'defaultAfternoonStart', 'showPreFilledInterval', 'updatedAt'
          ]);
        allow delete: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'schedules.delete')))
          && isValidId(scheduleId)
          && existing().ownerId == userId;
      }

      match /employees/{employeeId} {
        allow get: if (isOwner(userId) || (resource != null && memberHasCompany(userId, existing().companyId)))
          && isValidId(employeeId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (isActiveWorkspaceMember(userId) && resource.data.companyId in get(accessLinkPath()).data.allowedCompanyIds);
        allow create: if (isOwner(userId) || (memberHasCompany(userId, incoming().companyId) && (memberHasPermission(userId, 'employees.create') || memberHasPermission(userId, 'importEmployees.import'))))
          && isValidId(employeeId)
          && isValidEmployee(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/companies/$(incoming().companyId))
          && exists(/databases/$(database)/documents/users/$(userId)/schedules/$(incoming().scheduleId));
        allow update: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && (memberHasPermission(userId, 'employees.edit') || memberHasPermission(userId, 'importEmployees.import'))))
          && isValidId(employeeId)
          && isValidEmployee(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().companyId == existing().companyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/schedules/$(incoming().scheduleId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'scheduleId', 'name', 'role', 'cpf', 'registrationNumber',
            'admissionDate', 'active', 'updatedAt'
          ]);
        allow delete: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'employees.delete')))
          && isValidId(employeeId)
          && existing().ownerId == userId;
      }

      match /customHolidays/{holidayId} {
        allow get: if (isOwner(userId) || (resource != null && memberHasCompany(userId, existing().companyId)))
          && isValidId(holidayId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (isActiveWorkspaceMember(userId) && resource.data.companyId in get(accessLinkPath()).data.allowedCompanyIds);
        allow create: if (isOwner(userId) || (memberHasCompany(userId, incoming().companyId) && memberHasPermission(userId, 'holidays.create')))
          && isValidId(holidayId)
          && isValidCustomHoliday(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/companies/$(incoming().companyId));
        allow update: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'holidays.edit')))
          && isValidId(holidayId)
          && isValidCustomHoliday(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().companyId == existing().companyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'dateKey', 'recurringYearly', 'updatedAt']);
        allow delete: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'holidays.delete')))
          && isValidId(holidayId)
          && existing().ownerId == userId;
      }

      match /monthOverrides/{overrideId} {
        allow get: if (isOwner(userId) || (resource != null && memberHasCompany(userId, existing().companyId)))
          && isValidId(overrideId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (isActiveWorkspaceMember(userId) && resource.data.companyId in get(accessLinkPath()).data.allowedCompanyIds);
        allow create: if (isOwner(userId) || (memberHasCompany(userId, incoming().companyId) && memberHasPermission(userId, 'studio.edit_day')))
          && isValidId(overrideId)
          && isValidMonthOverride(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/companies/$(incoming().companyId));
        allow update: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'studio.edit_day')))
          && isValidId(overrideId)
          && isValidMonthOverride(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().companyId == existing().companyId
          && incoming().yearMonth == existing().yearMonth
          && incoming().targetId == existing().targetId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['dayOverrides', 'updatedAt']);
        allow delete: if (isOwner(userId) || (memberHasCompany(userId, existing().companyId) && memberHasPermission(userId, 'studio.edit_day')))
          && isValidId(overrideId)
          && existing().ownerId == userId;
      }

      match /teamUsers/{teamUserId} {
        allow get: if (isOwner(userId) || memberHasPermission(userId, 'users.view') || (resource != null && existing().authUid == request.auth.uid))
          && isValidId(teamUserId)
          && (resource == null || existing().ownerId == userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (memberHasPermission(userId, 'users.view') && resource.data.ownerId == userId);
        allow create: if (isOwner(userId) || memberHasPermission(userId, 'users.create'))
          && isValidId(teamUserId)
          && isValidTeamUser(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/accessProfiles/$(incoming().profileId));
        allow update: if (isOwner(userId) || memberHasPermission(userId, 'users.edit'))
          && isValidId(teamUserId)
          && isValidTeamUser(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().authUid == existing().authUid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/accessProfiles/$(incoming().profileId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'profileId', 'allowedCompanyIds', 'active', 'role', 'updatedAt']);
        allow delete: if (isOwner(userId) || memberHasPermission(userId, 'users.delete'))
          && isValidId(teamUserId)
          && existing().ownerId == userId;
      }
    }
  }
}
